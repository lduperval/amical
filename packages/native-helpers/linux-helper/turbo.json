{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "resources/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "outputs": [
        "target/variants/**/release/linux-helper",
        "bin/linux-helper"
      ],
      "env": ["AMICAL_INPUT_METHOD"],
      "cache": true
    }
  }
}
