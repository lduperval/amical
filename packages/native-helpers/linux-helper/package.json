{
  "name": "@amical/linux-helper",
  "version": "0.1.0",
  "description": "Rust native helper for Wayland integration on Linux",
  "private": true,
  "scripts": {
    "build": "pnpm build:native",
    "build:native": "node scripts/build.mjs",
    "build:uinput": "node scripts/build.mjs uinput",
    "clean": "rm -rf target bin .turbo",
    "dev": "node scripts/build.mjs --debug",
    "verify:uinput": "node scripts/verify.mjs uinput"
  },
  "files": [
    "bin/*"
  ],
  "keywords": [
    "rust",
    "native",
    "wayland",
    "linux"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
