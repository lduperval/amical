{
  "name": "@amical/linux-helper",
  "version": "0.1.0",
  "description": "Rust native helper for Wayland integration on Linux",
  "private": true,
  "scripts": {
    "build": "pnpm build:native",
    "build:native": "node scripts/build.mjs",
    "build:uinput": "node scripts/build.mjs uinput",
    "clean": "rm -rf target bin .turbo",
    "dev": "node scripts/build.mjs --debug",
    "verify:uinput": "node scripts/verify.mjs uinput",
    "build:gnome-ext": "node scripts/build.mjs gnome_ext",
    "verify:gnome-ext": "node scripts/verify.mjs gnome_ext",
    "pack:gnome-extension": "node scripts/pack-gnome-extension.mjs",
    "check:gnome-extension": "node --input-type=module --check < gnome-extension/amical@amical.ai/extension.js"
  },
  "files": [
    "bin/*",
    "bin/gnome-extension/*"
  ],
  "keywords": [
    "rust",
    "native",
    "wayland",
    "linux"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
